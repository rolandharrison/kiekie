# Copy to mcp/.env and fill in. Create the service token in Cloudflare Zero Trust.
# API_BASE/WEB_BASE are the https origin of your deployed kiekie instance.
API_BASE=https://your-kiekie-domain.example
WEB_BASE=https://your-kiekie-domain.example
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
PATH_MAP=C:\Dev=/host/dev
HOST_WORK_DIR=C:\Dev
