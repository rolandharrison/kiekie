# Copy to .env.local and fill in. .env.local is gitignored.

# Cloudflare API token with Workers Scripts / D1 / R2 edit permissions.
CLOUDFLARE_API_TOKEN=
# Required: wrangler.toml carries no account_id, so deploys read it from here.
CLOUDFLARE_ACCOUNT_ID=

# Production hostname (kept out of the repo). Used by `npm run attach:domain`.
APP_HOSTNAME=

# Production Worker secrets — set once with `wrangler secret put <NAME> --env
# production` from the worker/ directory; recorded here so they can be re-set.
# WEB_BASE=https://<APP_HOSTNAME>
# ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# ACCESS_AUD=<Access application audience tag>

# Cloudflare Access service token for the MCP server (created in Zero Trust).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
