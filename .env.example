# Copy to .env.local and fill in. .env.local is gitignored.

# Cloudflare API token with Workers Scripts / D1 / R2 edit permissions.
CLOUDFLARE_API_TOKEN=
# Only needed if the token has access to more than one account.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Access service token for the MCP server (created in Zero Trust).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
