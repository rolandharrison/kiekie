# Block dependency lifecycle scripts (preinstall/install/postinstall) by default.
# This neutralizes the primary npm supply-chain attack vector — a trojanized
# package running code on `npm install` (e.g. the Shai-Hulud worm).
#
# Nothing in this project needs an install script to run: the only native deps
# (esbuild, workerd) ship their platform binaries as optional-dependency
# packages, which install regardless of this setting. Verified green across the
# unit suite and the full Playwright e2e (wrangler bundling + workerd).
#
# If a future dependency genuinely needs its install script, rebuild just that
# one explicitly: `npm rebuild <pkg> --ignore-scripts=false`.
ignore-scripts=true
