{
  "name": "@kiekie/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-assets.mjs && wrangler dev",
    "deploy": "wrangler deploy --env production",
    "migrate:local": "wrangler d1 migrations apply kiekie --local",
    "migrate:remote": "wrangler d1 migrations apply kiekie --remote --env production",
    "e2e:migrate": "wrangler d1 migrations apply kiekie --local --persist-to .e2e-state",
    "e2e:dev": "wrangler dev --port 8788 --persist-to .e2e-state",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/ensure-assets.mjs && vitest run"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.11",
    "wrangler": "^4.120.0"
  }
}
