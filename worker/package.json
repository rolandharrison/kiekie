{
  "name": "@kiekie/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "migrate:local": "wrangler d1 migrations apply kiekie --local",
    "migrate:remote": "wrangler d1 migrations apply kiekie --remote --env production",
    "e2e:migrate": "wrangler d1 migrations apply kiekie --local --persist-to .e2e-state",
    "e2e:dev": "wrangler dev --port 8788 --persist-to .e2e-state",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-assets.mjs",
    "predev": "node scripts/ensure-assets.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.35",
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "vitest": "3.2.6",
    "wrangler": "^3.99.0"
  }
}
